<Window x:Class="IracingOverlay.App.Settings.ShareLayoutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:IracingOverlay.App.Settings"
        Title="Sync session layouts" Width="680" SizeToContent="Height" ResizeMode="NoResize"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource S.Window}">
    <Window.Resources>
        <ResourceDictionary Source="/IracingOverlay;component/Themes/Settings.xaml" />
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="Prompt" Style="{StaticResource SettingName}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource PageDescription}" Margin="0,6,0,16"
                       Text="Only differing settings are listed. Choose the session layout to use for all three." />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource SettingsGroup}" Margin="0" Padding="4">
            <DataGrid x:Name="Differences" AutomationProperties.Name="Session layout differences"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                      CanUserSortColumns="False" GridLinesVisibility="None" MaxHeight="350"
                      BorderThickness="0" Background="{StaticResource S.Card}" RowBackground="{StaticResource S.Card}"
                      Foreground="{StaticResource S.Text}" HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource S.Card}" />
                        <Setter Property="Foreground" Value="{StaticResource S.TextDim}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="8,6" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource S.Sidebar}" Padding="8,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource S.Accent}" />
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Setting" Binding="{Binding Setting}" Width="1.7*" />
                    <DataGridTextColumn Header="Practice" Binding="{Binding Practice}" Width="*" />
                    <DataGridTextColumn Header="Qualifying" Binding="{Binding Qualifying}" Width="*" />
                    <DataGridTextColumn Header="Race" Binding="{Binding Race}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" />
            <WrapPanel>
                <Button Content="Practice" Tag="{x:Static settings:LayoutSession.Practice}" Click="UseLayout" />
                <Button Content="Qualifying" Tag="{x:Static settings:LayoutSession.Qualifying}" Click="UseLayout" Margin="8,0" />
                <Button Content="Race" Tag="{x:Static settings:LayoutSession.Race}" Click="UseLayout" />
            </WrapPanel>
        </DockPanel>
    </Grid>
</Window>
