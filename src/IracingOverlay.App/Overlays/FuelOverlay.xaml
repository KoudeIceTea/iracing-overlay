<local:OverlayWindow x:Class="IracingOverlay.App.Overlays.FuelOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IracingOverlay.App.Overlays" Title="Fuel">
    <local:OverlayWindow.Resources>
        <!-- Column titles: brighter and slightly larger than the faint header labels, so they stay readable over
             bright parts of the game behind the glass. -->
        <Style x:Key="FuelColumnTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#B4C0D0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </local:OverlayWindow.Resources>
    <StackPanel MinWidth="384" HorizontalAlignment="Left">
        <Border x:Name="HeaderPanel" Style="{StaticResource GlassHeader}">
            <local:FuelBand x:Name="HeaderBand" />
        </Border>
        <Border x:Name="BodyPanel" Style="{StaticResource GlassPanel}" Padding="12,5">
            <StackPanel>
                <StackPanel x:Name="Table">
                    <Grid Margin="0,3,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="94" /><ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FuelColumnTitle}" HorizontalAlignment="Left" Text="CONSUMPTION" />
                        <TextBlock Grid.Column="1" Style="{StaticResource FuelColumnTitle}" Text="L / LAP" />
                        <TextBlock Grid.Column="2" Style="{StaticResource FuelColumnTitle}" Text="LAPS TO EMPTY" />
                        <TextBlock Grid.Column="3" Style="{StaticResource FuelColumnTitle}" Text="PITS TO END" />
                    </Grid>
                    <Border Height="1" Background="#33FFFFFF" Margin="0,0,0,3" />
                    <ItemsControl x:Name="UsageRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="94" /><ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Label}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding Usage}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#BBD5F2" Text="{Binding Remaining}" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding PitsToEnd}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <local:FuelBand x:Name="FooterBand" MinHeight="24" />
            </StackPanel>
        </Border>
    </StackPanel>
</local:OverlayWindow>
