<local:OverlayWindow x:Class="IracingOverlay.App.Overlays.RadarOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IracingOverlay.App.Overlays" Title="Radar">
    <local:OverlayWindow.Resources>
        <!-- Red side bars: solid next to your car, fading outwards. -->
        <LinearGradientBrush x:Key="LeftFill" StartPoint="1,0" EndPoint="0,0">
            <GradientStop Color="#F2DC2626" Offset="0" />
            <GradientStop Color="#B3DC2626" Offset="0.45" />
            <GradientStop Color="#00DC2626" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RightFill" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F2DC2626" Offset="0" />
            <GradientStop Color="#B3DC2626" Offset="0.45" />
            <GradientStop Color="#00DC2626" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="VerticalGuide" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00FFFFFF" Offset="0" />
            <GradientStop Color="#E6FFFFFF" Offset="0.3" />
            <GradientStop Color="#E6FFFFFF" Offset="0.7" />
            <GradientStop Color="#00FFFFFF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HorizontalGuide" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00FFFFFF" Offset="0" />
            <GradientStop Color="#CCFFFFFF" Offset="0.35" />
            <GradientStop Color="#CCFFFFFF" Offset="0.65" />
            <GradientStop Color="#00FFFFFF" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="SideBar" TargetType="Rectangle">
            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="64" />
            <Setter Property="RadiusX" Value="6" />
            <Setter Property="RadiusY" Value="6" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Effect"><Setter.Value><BlurEffect Radius="9" /></Setter.Value></Setter>
        </Style>
        <Style x:Key="Arc" TargetType="Path">
            <Setter Property="Stroke" Value="#FACC15" />
            <Setter Property="StrokeThickness" Value="16" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Effect"><Setter.Value><BlurEffect Radius="12" /></Setter.Value></Setter>
        </Style>
    </local:OverlayWindow.Resources>

    <!-- 440 × 340, your car's centre at (220,170). No glass panel: everything floats over the game.
         Drawn at 80 %: that's the radar's 100 % scale. -->
    <Grid>
    <Canvas x:Name="Root" Width="440" Height="340" Background="Transparent">
        <Canvas.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8" /></Canvas.LayoutTransform>
        <Canvas x:Name="Guides" Opacity="0.8">
            <Rectangle Canvas.Left="219" Canvas.Top="20" Width="2" Height="300" Fill="{StaticResource VerticalGuide}" />
            <Rectangle Canvas.Left="60" Canvas.Top="169" Width="320" Height="2" Fill="{StaticResource HorizontalGuide}" />
            <Rectangle Canvas.Left="130" Canvas.Top="137" Width="180" Height="1.5" Fill="{StaticResource HorizontalGuide}" Opacity="0.7" />
            <Rectangle Canvas.Left="130" Canvas.Top="201.5" Width="180" Height="1.5" Fill="{StaticResource HorizontalGuide}" Opacity="0.7" />
        </Canvas>

        <!-- Cars beside you: up to two per side (three wide). The inner bar sits against your car. -->
        <Rectangle x:Name="Left1" Style="{StaticResource SideBar}" Fill="{StaticResource LeftFill}" Canvas.Left="15" Canvas.Top="138">
            <Rectangle.RenderTransform><TranslateTransform /></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="Left2" Style="{StaticResource SideBar}" Fill="{StaticResource LeftFill}" Canvas.Left="-25" Canvas.Top="138" Opacity="0.75">
            <Rectangle.RenderTransform><TranslateTransform /></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="Right1" Style="{StaticResource SideBar}" Fill="{StaticResource RightFill}" Canvas.Left="225" Canvas.Top="138">
            <Rectangle.RenderTransform><TranslateTransform /></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="Right2" Style="{StaticResource SideBar}" Fill="{StaticResource RightFill}" Canvas.Left="265" Canvas.Top="138" Opacity="0.75">
            <Rectangle.RenderTransform><TranslateTransform /></Rectangle.RenderTransform>
        </Rectangle>

        <!-- A car close behind / ahead: an arc around your car at radius 100, scaled to the distance. -->
        <Path x:Name="BehindArc" Style="{StaticResource Arc}" Data="M 133.4,220 A 100,100 0 0 0 306.6,220">
            <Path.RenderTransform><ScaleTransform CenterX="220" CenterY="170" /></Path.RenderTransform>
        </Path>
        <Path x:Name="AheadArc" Style="{StaticResource Arc}" Data="M 133.4,120 A 100,100 0 0 1 306.6,120">
            <Path.RenderTransform><ScaleTransform CenterX="220" CenterY="170" /></Path.RenderTransform>
        </Path>

        <Border x:Name="Car" Canvas.Left="205" Canvas.Top="138" Width="30" Height="64" CornerRadius="5" Background="White">
            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.6" /></Border.Effect>
        </Border>
    </Canvas>
    </Grid>
</local:OverlayWindow>
