<UserControl x:Class="IracingOverlay.App.Overlays.DeltaBand"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="BandLabel" TargetType="TextBlock" BasedOn="{StaticResource HeaderLabel}">
            <Setter Property="Foreground" Value="#B4C0D0" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style x:Key="BandItem" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
    </UserControl.Resources>
    <StackPanel x:Name="Fields" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Tag="Title" Background="#3222C55E" Style="{StaticResource Pill}">
            <TextBlock Text="DELTA" Foreground="#86EFAC" Style="{StaticResource PillText}" />
        </Border>
        <TextBlock Tag="Reference" x:Name="Reference" Style="{StaticResource HeaderValue}" Margin="0,0,14,0" />
        <StackPanel Tag="Current" Style="{StaticResource BandItem}">
            <TextBlock Text="LAP" Style="{StaticResource BandLabel}" />
            <TextBlock x:Name="Current" Style="{StaticResource HeaderValue}" />
        </StackPanel>
        <StackPanel Tag="Last" Style="{StaticResource BandItem}">
            <TextBlock Text="LAST" Style="{StaticResource BandLabel}" />
            <TextBlock x:Name="Last" Style="{StaticResource HeaderValue}" />
        </StackPanel>
        <StackPanel Tag="Best" Style="{StaticResource BandItem}">
            <TextBlock Text="BEST" Style="{StaticResource BandLabel}" />
            <TextBlock x:Name="Best" Style="{StaticResource HeaderValue}" />
        </StackPanel>
        <StackPanel Tag="Optimal" Style="{StaticResource BandItem}">
            <TextBlock Text="OPTIMAL" Style="{StaticResource BandLabel}" />
            <TextBlock x:Name="Optimal" Style="{StaticResource HeaderValue}" />
        </StackPanel>
        <StackPanel Tag="SessionBest" Style="{StaticResource BandItem}">
            <TextBlock Text="CLASS BEST" Style="{StaticResource BandLabel}" />
            <TextBlock x:Name="SessionBest" Style="{StaticResource HeaderValue}" Foreground="#E9D5FF" />
        </StackPanel>
    </StackPanel>
</UserControl>
