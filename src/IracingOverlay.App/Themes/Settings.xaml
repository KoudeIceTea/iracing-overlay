<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Palette ===== -->
    <SolidColorBrush x:Key="S.Window" Color="#0F1318" />
    <SolidColorBrush x:Key="S.Sidebar" Color="#131820" />
    <SolidColorBrush x:Key="S.Card" Color="#171D26" />
    <SolidColorBrush x:Key="S.CardHover" Color="#1B2230" />
    <SolidColorBrush x:Key="S.Stroke" Color="#252D3A" />
    <SolidColorBrush x:Key="S.Divider" Color="#20283A" />
    <SolidColorBrush x:Key="S.Text" Color="#EDF2F9" />
    <SolidColorBrush x:Key="S.TextDim" Color="#96A3B5" />
    <SolidColorBrush x:Key="S.TextFaint" Color="#6B7889" />
    <SolidColorBrush x:Key="S.Accent" Color="#4DA3FF" />
    <SolidColorBrush x:Key="S.AccentSoft" Color="#1E3550" />
    <SolidColorBrush x:Key="S.Control" Color="#222A36" />
    <SolidColorBrush x:Key="S.ControlHover" Color="#2C3646" />
    <SolidColorBrush x:Key="S.ControlStroke" Color="#364154" />

    <!-- ===== Page structure ===== -->
    <Style x:Key="SettingsTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource S.Text}" />
    </Style>
    <Style x:Key="PageDescription" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource S.TextDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,22" />
    </Style>
    <!-- Content column (used with ReadableColumn, which caps the width at 720 and keeps it left-aligned) -->
    <Style x:Key="PageColumn" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,0,18,24" />
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource S.TextFaint}" />
        <Setter Property="Margin" Value="2,6,0,8" />
    </Style>

    <!-- A group of setting rows on one card -->
    <Style x:Key="SettingsGroup" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource S.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource S.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Margin" Value="0,0,0,18" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- Single padded card (e.g. the reorderable field lists) -->
    <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource SettingsGroup}">
        <Setter Property="Padding" Value="14,8" />
    </Style>
    <!-- One setting: name + description on the left, control on the right -->
    <Style x:Key="SettingRow" TargetType="DockPanel">
        <Setter Property="Margin" Value="18,14" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="LastChildFill" Value="True" />
    </Style>
    <Style x:Key="RowDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource S.Divider}" />
    </Style>
    <Style x:Key="SettingName" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource S.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SettingHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource S.TextDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,24,0" />
    </Style>
    <Style x:Key="RowIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource S.TextDim}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="DockPanel.Dock" Value="Left" />
    </Style>

    <!-- ===== Drag handle for reorderable lists ===== -->
    <Style x:Key="FieldGrip" TargetType="Thumb">
        <Setter Property="Width" Value="26" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Cursor" Value="SizeNS" />
        <Setter Property="ToolTip" Value="Drag to reorder, or use the up and down arrow keys." />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Grip" Background="Transparent" CornerRadius="5">
                        <TextBlock Text="&#xE76F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource S.TextFaint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource S.ControlHover}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource S.ControlHover}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Buttons ===== -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource S.Text}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" CornerRadius="6" Background="{StaticResource S.Control}" BorderBrush="{StaticResource S.ControlStroke}"
                            BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource S.ControlHover}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource S.Accent}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource S.AccentSoft}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Square icon button (scale − / +) -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ===== Password field (update token) ===== -->
    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource S.Text}" />
        <Setter Property="Background" Value="{StaticResource S.Control}" />
        <Setter Property="BorderBrush" Value="{StaticResource S.ControlStroke}" />
        <Setter Property="CaretBrush" Value="{StaticResource S.Text}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Box" CornerRadius="6" BorderThickness="1"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource S.Accent}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Dropdown ===== -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource S.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Padding="12,8" Margin="4,1" CornerRadius="5" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource S.ControlHover}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource S.AccentSoft}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource S.Text}" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Box" CornerRadius="6" Background="{StaticResource S.Control}"
                                            BorderBrush="{StaticResource S.ControlStroke}" BorderThickness="1">
                                        <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{StaticResource S.TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource S.ControlHover}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"
                                          Margin="12,0,32,0" VerticalAlignment="Center" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               PopupAnimation="Fade" Focusable="False">
                            <Border Background="#1B222D" BorderBrush="{StaticResource S.ControlStroke}" BorderThickness="1" CornerRadius="8"
                                    Margin="0,4,0,0" Padding="0,4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Toggle switch (CheckBox): content on the left, switch on the right ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource S.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent">
                        <Border DockPanel.Dock="Right" x:Name="Track" Width="40" Height="20" Margin="16,0,0,0" VerticalAlignment="Center"
                                Background="Transparent" BorderBrush="#7D8898" BorderThickness="1.5" CornerRadius="10">
                            <Ellipse x:Name="Knob" Width="10" Height="10" Margin="4,0" HorizontalAlignment="Left" Fill="#C5CEDA" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Width" Value="12" />
                            <Setter TargetName="Knob" Property="Height" Value="12" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource S.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource S.Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="#0B1724" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="White" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Sidebar navigation (main TabControl items) ===== -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource S.Text}" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="14,10">
                            <StackPanel x:Name="NavLabel" Orientation="Horizontal" TextElement.Foreground="{StaticResource S.TextDim}">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Margin="0,0,14,0" VerticalAlignment="Center" />
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="Marker" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{StaticResource S.Accent}" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#1A212B" /></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#1E2733" />
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                            <Setter TargetName="NavLabel" Property="TextElement.Foreground" Value="{StaticResource S.Text}" />
                            <Setter TargetName="NavLabel" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource S.Accent}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Segmented control (per-overlay General / Content / Header / Footer) ===== -->
    <Style x:Key="SegmentTab" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource S.TextDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Seg" Padding="16,7" Margin="2" CornerRadius="6" Background="Transparent">
                        <ContentPresenter x:Name="Text" ContentSource="Header" TextElement.FontSize="13" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Seg" Property="Background" Value="{StaticResource S.ControlHover}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Seg" Property="Background" Value="{StaticResource S.ControlStroke}" />
                            <Setter Property="Foreground" Value="{StaticResource S.Text}" />
                            <Setter TargetName="Text" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Seg" Property="Background" Value="{StaticResource S.ControlHover}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Slim dark scrollbar ===== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" CornerRadius="3" Background="#3A4556" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#566377" /></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Background" Value="#6C7A90" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Margin" Value="0,2,2,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
