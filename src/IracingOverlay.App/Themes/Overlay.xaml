<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:overlays="clr-namespace:IracingOverlay.App.Overlays">

    <!-- ===== Palette ===== -->
    <SolidColorBrush x:Key="TextBrush" Color="#F2F4F8" />
    <SolidColorBrush x:Key="DimTextBrush" Color="#8A93A3" />
    <SolidColorBrush x:Key="FaintTextBrush" Color="#5C6575" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4DA3FF" />
    <SolidColorBrush x:Key="PitBrush" Color="#FFC83D" />
    <SolidColorBrush x:Key="ChipBrush" Color="#1AFFFFFF" />

    <FontFamily x:Key="OverlayFont">Montserrat, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===== Glass surfaces (real blur is applied behind these by OverlayWindow) ===== -->
    <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#9E1A1F29" Offset="0" />
        <GradientStop Color="#B80E1117" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassStroke" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40FFFFFF" Offset="0" />
        <GradientStop Color="#0FFFFFFF" Offset="0.5" />
        <GradientStop Color="#1AFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassHeaderFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D2141821" Offset="0" />
        <GradientStop Color="#E00A0C11" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="GlassPanel" TargetType="Border">
        <Setter Property="overlays:Glass.IsSurface" Value="True" />
        <Setter Property="Background" Value="{StaticResource GlassFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="GlassHeader" TargetType="Border" BasedOn="{StaticResource GlassPanel}">
        <Setter Property="Background" Value="{StaticResource GlassHeaderFill}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,3" />
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <!-- ===== Header items ===== -->
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,1,6,0" />
    </Style>

    <Style x:Key="HeaderValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HeaderLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource FaintTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,1,5,0" />
    </Style>

    <!-- Horizontal group of header items with spacing between groups -->
    <Style x:Key="HeaderGroup" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,0,18,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource ChipBrush}" />
    </Style>

    <Style x:Key="PillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Rows ===== -->
    <Style x:Key="ColumnHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FaintTextBrush}" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <Style x:Key="Cell" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style x:Key="PosCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="NameCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="NumCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Tinted outlined badge (license, car number) -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="19" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- "#24" in the class colour -->
    <Style x:Key="CarNumberCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="2,0,0,0" />
    </Style>

    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Subtle box behind the iRating (relative) -->
    <Style x:Key="ValueBox" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="Height" Value="19" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- "PIT" tag, shown only when the car is on pit road -->
    <Style x:Key="PitTag" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PitBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Margin" Value="6,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding InPit}" Value="True">
                <Setter Property="Visibility" Value="{DynamicResource Content.Pit}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DriverImage" TargetType="Image">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        <Style.Triggers>
            <Trigger Property="Source" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="DriverBrandCell">
        <Image Source="{Binding Brand}" AutomationProperties.Name="{Binding Icons.CarModel}"
               Style="{StaticResource DriverImage}" Width="23" Height="23" />
    </DataTemplate>
    <DataTemplate x:Key="DriverFlagCell">
        <Image Source="{Binding Flag}" AutomationProperties.Name="{Binding Icons.FlairName}"
               Style="{StaticResource DriverImage}" Width="18" Height="14" />
    </DataTemplate>
    <!-- Penalty badge beside a driver row (standings and relative): flags as icons (black, slowdown = furled
         black, meatball), then how long the most important one has been up, "DQ", or your own repair time left.
         The overlay sets which side of the table it hugs (Penalty.Alignment / Penalty.Margin). -->
    <BooleanToVisibilityConverter x:Key="ShowWhenTrue" />
    <DataTemplate x:Key="PenaltyBadge">
        <Grid Height="{Binding RowHeight}">
            <Border Style="{StaticResource GlassPanel}" CornerRadius="4" Padding="4,1" Margin="{DynamicResource Penalty.Margin}"
                    Background="#ED191D24" HorizontalAlignment="{DynamicResource Penalty.Alignment}" VerticalAlignment="Center"
                    Visibility="{Binding HasPenalty, Converter={StaticResource ShowWhenTrue}}">
                <StackPanel Orientation="Horizontal">
                    <Image Width="23" Height="18" Source="{Binding BlackFlagIcon}" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding BlackFlag, Converter={StaticResource ShowWhenTrue}}" />
                    <Image Width="23" Height="18" Source="{Binding SlowdownIcon}" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding Slowdown, Converter={StaticResource ShowWhenTrue}}" />
                    <Image Width="23" Height="18" Source="{Binding RepairIcon}" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding Meatball, Converter={StaticResource ShowWhenTrue}}" />
                    <TextBlock Text="{Binding PenaltyText}" VerticalAlignment="Center" FontSize="10.5" FontWeight="Bold"
                               Foreground="#FFF4F5F7" Margin="4,0,1,0" />
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>
    <!-- Driver name; in team races the team name in large type with the current driver small underneath -->
    <DataTemplate x:Key="DriverNameCell">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="{DynamicResource Name.MaxWidth}">
            <TextBlock x:Name="Single" Style="{StaticResource NameCell}" Text="{Binding Name}" Foreground="{Binding NameForeground}" />
            <StackPanel x:Name="Team" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource NameCell}" Text="{Binding TeamName}" Foreground="{Binding NameForeground}" />
                <TextBlock Style="{StaticResource Cell}" Text="{Binding Name}" FontSize="10.5" FontWeight="Medium"
                           Foreground="{StaticResource DimTextBrush}" Margin="0,-1,0,0" />
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasTeam}" Value="True">
                <Setter TargetName="Single" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Team" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="DriverPitCell">
        <Border Style="{StaticResource PitTag}" HorizontalAlignment="Center" Margin="0">
            <TextBlock Text="PIT" FontSize="9" FontWeight="Bold" Foreground="#0B0D12" VerticalAlignment="Center" />
        </Border>
    </DataTemplate>

    <!-- Accent bar on the left of the focus row -->
    <Style x:Key="FocusMarker" TargetType="Border">
        <Setter Property="Width" Value="3" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="CornerRadius" Value="0,2,2,0" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFocus}" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
